@host = http://localhost:5080
@aliceIncidentId = 20000000-0000-0000-0000-000000000001

### Health/readiness
GET {{host}}/health
Accept: application/json

### Working list flow
GET {{host}}/api/incidents
Accept: application/json

### Filtered list
GET {{host}}/api/incidents?status=Triaged
Accept: application/json

### Existing details
GET {{host}}/api/incidents/{{aliceIncidentId}}
Accept: application/json

### Missing resource: expected 404 Problem Details
GET {{host}}/api/incidents/99999999-9999-9999-9999-999999999999
Accept: application/json

### Invalid filter: expected 400 Validation Problem Details
GET {{host}}/api/incidents?status=Unknown
Accept: application/json

### Lab 1 extension point: expected 200 ОК and a list of each incident severity class and their count
# Content-Type: application/json; charset=utf-8
# Тіло: JSON-масив елементів { severity, count }, без інших полів.
# Політика нульових груп: повний перелік рівнів (відсутній має count: 0).
# Порядок: Critical, High, Medium, Low.
# На baseline seed: Critical 0, High 1, Medium 1, Low 1.
GET {{host}}/api/incidents/severity-summary
Accept: application/json

